APP_NAME="Zaku Backend API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Scribe API docs base URL
SCRIBE_BASE_URL=http://127.0.0.1:8000

# Frontend (CORS + redirects)
FRONTEND_URL=http://127.0.0.1:5173
FRONTEND_URL_DEV=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zaku_api
DB_USERNAME=root
DB_PASSWORD=

# Database (SQLite — uncomment for testing)
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

# Cache / Session / Queue
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Redis (optional, for cache/queue)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (for websockets/broadcasting)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# JWT (tymon/jwt-auth)
JWT_SECRET=
JWT_TTL=1440
JWT_REMEMBER_TTL=43200
JWT_REFRESH_TTL=20160

# Feature Flags
FEATURE_EMAIL_VERIFICATION=false

# Sentry (error tracking)
SENTRY_LARAVEL_DSN=

# AI Parser (Groq + Gemini)
GROQ_API_KEY=
GEMINI_API_KEY=

# Rate Limiting
API_RATE_LIMIT=100
REGISTRATION_RATE_LIMIT=5
VERIFICATION_RATE_LIMIT=3
PASSWORD_RESET_RATE_LIMIT=3
